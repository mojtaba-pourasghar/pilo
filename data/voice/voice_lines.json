   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 29"
  },
  {
   "id": "l30_intro_1",
   "file": "voice/l30_intro_1.mp3",
   "who": "pilo",
   "text": "همهٔ رنگارستان برای جشن جمع شده‌اند! فقط یک دروازهٔ دیگر مانده.",
