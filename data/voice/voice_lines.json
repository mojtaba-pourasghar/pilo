   "event": "شروع مرحله — مرحلهٔ 1"
  },
  {
   "id": "l01_intro_3",
   "file": "voice/l01_intro_3.mp3",
   "who": "pilo",
   "text": "غبارک تکه‌های زمان را پخش کرده. بیا پیدایشان کنیم!",
