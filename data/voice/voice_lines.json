   "kind": "outro",
   "event": "پایان مرحله — مرحلهٔ 1"
  },
  {
   "id": "l01_sign_1",
   "file": "voice/l01_sign_1.mp3",
   "who": "pilo",
   "text": "با دکمه‌های آبی راه برو.",
