   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 28"
  },
  {
   "id": "l28_intro_2",
   "file": "voice/l28_intro_2.mp3",
   "who": "nima",
   "text": "سنگ‌های لرزان، پل، کلید بلوری، نور... بزن بریم!",
   "level": 28,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 28"
  },
  {
   "id": "l29_intro_1",
   "file": "voice/l29_intro_1.mp3",
   "who": "ghubarak",
   "text": "کمک! این بار خودم توی حبابِ زمان گیر افتاده‌ام!",
   "level": 29,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 29"
  },
  {
   "id": "l29_intro_2",
   "file": "voice/l29_intro_2.mp3",
   "who": "nima",
   "text": "غبارک! صبر کن، داریم می‌آییم.",
   "level": 29,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 29"
  },
  {
   "id": "l29_intro_3",
   "file": "voice/l29_intro_3.mp3",
   "who": "pilo",
   "text": "نور را از دو آینه بگذران تا دروازه باز شود.",
