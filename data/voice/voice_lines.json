   "event": "نجات دوست — مرحلهٔ 29"
  },
  {
   "id": "l29_sign_1",
   "file": "voice/l29_sign_1.mp3",
   "who": "pilo",
   "text": "دو آینه، یکی پایین و یکی بالا.",
