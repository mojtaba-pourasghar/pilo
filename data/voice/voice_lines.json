   "event": "تابلوی 2 مرحلهٔ 1"
  },
  {
   "id": "l01_sign_3",
   "file": "voice/l01_sign_3.mp3",
   "who": "pilo",
   "text": "ستاره‌ها اختیاری‌اند؛ ولی پیلو عاشقشان است!",
