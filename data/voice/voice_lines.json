 "lines": [
  {
   "id": "l21_intro_1",
   "file": "voice/l21_intro_1.mp3",
   "who": "nima",
   "text": "چه غار قشنگی! بلورها خاموش‌اند.",
   "level": 21,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 21"
  },
  {
   "id": "l21_intro_2",
   "file": "voice/l21_intro_2.mp3",
   "who": "pilo",
   "text": "بلورها با نور روشن و محکم می‌شوند. ولی یک چیزی جلوی نور را گرفته...",
   "level": 21,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 21"
  },
  {
   "id": "l21_sign_1",
   "file": "voice/l21_sign_1.mp3",
   "who": "pilo",
   "text": "در گذشته بلورهای بزرگ جلوی نور را می‌گرفتند.",
   "level": 21,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 21"
  },
  {
   "id": "l21_sign_2",
   "file": "voice/l21_sign_2.mp3",
   "who": "pilo",
   "text": "نور به چشمِ بلوری برسد، دروازه باز می‌شود.",
   "level": 21,
   "kind": "sign",
   "event": "تابلوی 2 مرحلهٔ 21"
  },
  {
   "id": "l22_intro_1",
   "file": "voice/l22_intro_1.mp3",
   "who": "pilo",
   "text": "این آینه نور را برمی‌گرداند. به آن دست بزن تا بچرخد!",
   "level": 22,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 22"
  },
  {
   "id": "l22_sign_1",
   "file": "voice/l22_sign_1.mp3",
   "who": "pilo",
   "text": "به آینه بخور تا بچرخد؛ نور را به چشمِ بالا برسان.",
   "level": 22,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 22"
  },
  {
   "id": "l23_intro_1",
   "file": "voice/l23_intro_1.mp3",
   "who": "nima",
   "text": "بلورهای روی گودال خاموش‌اند. نمی‌شود از رویشان رد شد.",
   "level": 23,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 23"
  },
  {
   "id": "l23_intro_2",
   "file": "voice/l23_intro_2.mp3",
   "who": "pilo",
   "text": "نور باید از دو آینه بگذرد تا به آن‌ها برسد.",
   "level": 23,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 23"
  },
  {
   "id": "l23_sign_1",
   "file": "voice/l23_sign_1.mp3",
   "who": "pilo",
   "text": "دو آینه را بچرخان تا نور به بلورها برسد.",
   "level": 23,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 23"
  },
  {
   "id": "l24_intro_1",
   "file": "voice/l24_intro_1.mp3",
   "who": "pilo",
   "text": "این در دو قفل دارد: یک کلید بلوری و یک پرتوی نور.",
   "level": 24,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 24"
  },
  {
   "id": "l24_intro_2",
   "file": "voice/l24_intro_2.mp3",
   "who": "nima",
   "text": "یکی در گذشته است و یکی در حال؟",
   "level": 24,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 24"
  },
  {
   "id": "l24_sign_1",
   "file": "voice/l24_sign_1.mp3",
   "who": "pilo",
   "text": "کلید بلوری روی جزیره است؛ پلِ چوبی فقط در گذشته بود.",
   "level": 24,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 24"
  },
  {
   "id": "l25_intro_1",
   "file": "voice/l25_intro_1.mp3",
   "who": "nima",
   "text": "این سنگ‌ها ترک دارند!",
   "level": 25,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 25"
  },
  {
   "id": "l25_intro_2",
   "file": "voice/l25_intro_2.mp3",
   "who": "pilo",
   "text": "در حال می‌ریزند... ولی در گذشته هنوز محکم بودند.",
   "level": 25,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 25"
  },
  {
   "id": "l25_sign_1",
   "file": "voice/l25_sign_1.mp3",
   "who": "pilo",
   "text": "در حال این سنگ‌ها می‌ریزند. در گذشته محکم بودند!",
   "level": 25,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 25"
  },
  {
   "id": "l26_intro_1",
   "file": "voice/l26_intro_1.mp3",
   "who": "pilo",
   "text": "سه چشمِ بلوری، سه پرتوی نور. هر سه باید روشن شوند.",
   "level": 26,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 26"
  },
  {
   "id": "l26_intro_2",
   "file": "voice/l26_intro_2.mp3",
   "who": "nima",
   "text": "یکی‌یکی! اول اولی.",
   "level": 26,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 26"
  },
  {
   "id": "l26_sign_1",
   "file": "voice/l26_sign_1.mp3",
   "who": "pilo",
   "text": "هر آینه نورش را به یک چشم می‌رساند.",
   "level": 26,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 26"
  },
  {
   "id": "l27_intro_1",
   "file": "voice/l27_intro_1.mp3",
   "who": "nima",
   "text": "آب! نمی‌شود از آب رد شد.",
   "level": 27,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 27"
  },
  {
   "id": "l27_intro_2",
   "file": "voice/l27_intro_2.mp3",
   "who": "pilo",
   "text": "اگر نور به بلورهای روی آب برسد، یک راه امن ساخته می‌شود.",
   "level": 27,
   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 27"
  },
  {
   "id": "l27_sign_1",
   "file": "voice/l27_sign_1.mp3",
   "who": "pilo",
   "text": "راه امن از روی بلورهای روشن است.",
   "level": 27,
   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 27"
  },
  {
   "id": "l28_intro_1",
   "file": "voice/l28_intro_1.mp3",
   "who": "pilo",
   "text": "این آخرین تکهٔ زمانِ غارهاست! همه‌چیز را با هم لازم داریم.",
