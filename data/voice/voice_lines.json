   "kind": "sign",
   "event": "تابلوی 1 مرحلهٔ 30"
  },
  {
   "id": "l01_intro_1",
   "file": "voice/l01_intro_1.mp3",
   "who": "pilo",
   "text": "سلام نیما! من پیلو هستم.",
