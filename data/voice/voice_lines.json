   "kind": "intro",
   "event": "شروع مرحله — مرحلهٔ 3"
  },
  {
   "id": "l03_intro_2",
   "file": "voice/l03_intro_2.mp3",
   "who": "nima",
   "text": "پس شاید پلِ شکسته در گذشته سالم بوده!",
