   "kind": "sign",
   "event": "تابلوی 2 مرحلهٔ 2"
  },
  {
   "id": "l03_intro_1",
   "file": "voice/l03_intro_1.mp3",
   "who": "pilo",
   "text": "این لنز زمان است! با آن گذشته و حالِ جنگل را می‌بینی.",
