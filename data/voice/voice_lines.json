   "event": "پایان مرحله — مرحلهٔ 1"
  },
  {
   "id": "l01_outro_3",
   "file": "voice/l01_outro_3.mp3",
   "who": "nima",
   "text": "عیبی ندارد. با هم درستش می‌کنیم.",
