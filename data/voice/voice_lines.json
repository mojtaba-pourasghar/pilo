   "kind": "outro",
   "event": "پایان مرحله — مرحلهٔ 30"
  },
  {
   "id": "l30_sign_1",
   "file": "voice/l30_sign_1.mp3",
   "who": "pilo",
   "text": "آخرین بار: آینه، بلور، پل، فنر! همه را بلدی.",
