 ],
 "outro": [
  {
   "who": "eagle",
   "text": "این نقشهٔ قلعهٔ سایه است. راه از بالای ابرهاست.",
   "id": "l40_outro_1"
  },
  {
   "who": "butterfly",
   "text": "من پَرپَری‌ام! سُر خوردنت با من دو برابر طول می‌کشد؛ دره‌های پهن را با من رد شو.",
   "id": "l40_outro_2"
  },
  {
   "who": "pilo",
   "text": "از حالا در دهکده یا با دکمهٔ همراه، می‌توانی او را انتخاب کنی.",
   "id": "l40_outro_3"
  }
 ],
